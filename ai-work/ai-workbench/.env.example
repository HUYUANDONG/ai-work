# 复制为仓库根目录的 .env 后按环境填写。不要把真实密钥提交到仓库。
# Gateway / Service 启动时会自动加载该文件，不必在 IDEA 里填环境变量。
# 阶段一不连接 MySQL / Redis；这两项密钥留给阶段二。

# --- Nacos ---
WB_NACOS_SERVER_ADDR=127.0.0.1:8848
WB_NACOS_DISCOVERY_NAMESPACE=ai_workbench
WB_NACOS_DISCOVERY_ENABLED=true
WB_NACOS_CONFIG_ENABLED=false

# 无 Nacos 的本地直连（同时关闭注册）：
# WB_NACOS_DISCOVERY_ENABLED=false
# WB_DUBBO_REGISTRY=N/A
# WB_SERVICE_URI=http://127.0.0.1:8080

# --- Dubbo 注册（默认与 Nacos 相同；电商系统确认后改为其 namespace / group）---
WB_DUBBO_NACOS_NAMESPACE=ai_workbench
WB_DUBBO_NACOS_GROUP=dubbo
WB_DUBBO_CONSUMER_TIMEOUT_MS=3000
# WB_DUBBO_REGISTRY=nacos://127.0.0.1:8848

# --- 端口 ---
WB_GATEWAY_PORT=8081
WB_SERVICE_PORT=8080
WB_SERVICE_HOST=127.0.0.1

# --- 内部身份签名。local 允许留空（无签名）。dev/prod 必须填写 ---
WB_INTERNAL_IDENTITY_SECRET=
WB_ALLOW_UNSIGNED_IDENTITY=true

# --- MySQL（商品草稿 Mapper）。默认关闭，仍走内存仓储 ---
WB_MYSQL_ENABLED=false
# WB_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/ai_workbench?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai
# WB_MYSQL_USERNAME=
# WB_MYSQL_PASSWORD=
# WB_REDIS_HOST=127.0.0.1
# WB_REDIS_PORT=6379
# WB_REDIS_PASSWORD=
# WB_REDIS_SSL_ENABLED=false
