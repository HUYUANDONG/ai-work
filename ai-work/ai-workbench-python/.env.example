# Profile: local | dev | prod
WB_PROFILE=local

# LangGraph Checkpoint 独立 PostgreSQL（asyncpg 协议）
# 示例: postgresql+asyncpg://user:pass@127.0.0.1:5432/ai_workbench_checkpoint
WB_CHECKPOINT_DATABASE_URL=

# Java Workbench Service 内网 Base URL（与 Java wb.service.port 一致，默认 8080）
WB_JAVA_BASE_URL=http://127.0.0.1:8080

# true=读 fixtures/mock_features.json，不访问 Java（本地第一步联调）
# 与 Java 打通时改为 false：特征/任务/报告均走 /internal/*
WB_JAVA_MOCK_FEATURES=true

# 阿里云百炼决策模型（国内可用，协议兼容 System One Choice）
# 申请 Key：https://bailian.console.aliyun.com/?tab=model#/api-key
# 文档：https://help.aliyun.com/zh/model-studio/decision-model-api
DASHSCOPE_API_KEY=
WB_DECISION_INTENT_ENABLED=true
WB_DECISION_MODEL=decision-model-preview
WB_DECISION_MIN_CONFIDENCE=0.75
# 决策模型专用网关需要业务空间 ID（控制台右上角）。不填则意图走 qwen-plus
WB_DECISION_WORKSPACE_ID=
WB_DECISION_REGION=cn-beijing
# 可选覆盖网关，例如 https://dashscope.aliyuncs.com/compatible-mode
WB_DECISION_BASE_URL=
# 正式环境建议 false；本地无 Key 时可 true 降级规则
WB_DECISION_ALLOW_RULES_FALLBACK=true

# Java → Python / Python → Java 双向 HMAC 密钥（勿写入仓库）
WB_HMAC_SECRET_IN=
WB_HMAC_SECRET_OUT=

# Worker
WB_WORKER_POLL_INTERVAL_SECONDS=20
WB_WORKER_LEASE_SECONDS=60
WB_WORKER_CONCURRENCY=2

# 阿里云百炼 Chat Completions（报表叙事；不算正式分。Key 空则复用 DASHSCOPE_API_KEY）
WB_LLM_API_KEY=
WB_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WB_LLM_MODEL=qwen-plus
WB_REPORT_OUTPUT_DIR=tmp/reports
